<%- include('partials/header') %>

<!-- Hero Banner -->
<section class="section section-dark" style="padding-top: 140px; padding-bottom: 80px;">
  <div class="container" style="max-width: 900px;">
    <span class="kicker">EXAM DIRECTORY</span>
    <h1 style="margin: 12px 0 16px;">Government Exam Directory</h1>
    <p style="font-size: 1.05rem; max-width: 620px;">Filter by qualification, category, or keyword to find the right government exam for your profile.</p>
  </div>
</section>

<!-- Filter Bar -->
<section class="section-secondary" style="padding: 32px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container">
    <form action="/exams" method="GET">
      <div style="display: grid; grid-template-columns: 1fr 1fr 2fr auto; gap: 14px; align-items: flex-end;">
        <div>
          <label class="form-label" for="category">Category</label>
          <select name="category" id="category" class="form-control">
            <% categories.forEach(c => { %>
              <option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label" for="qualification">Qualification</label>
          <select name="qualification" id="qualification" class="form-control">
            <% qualifications.forEach(q => { %>
              <option value="<%= q %>" <%= selectedQualification === q ? 'selected' : '' %>><%= q %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label" for="search">Keyword Search</label>
          <input type="text" name="search" id="search" class="form-control" placeholder="Search exam name or code..." value="<%= searchQuery %>">
        </div>

        <div>
          <button type="submit" class="btn btn-primary w-full" style="height: 46px;">Filter</button>
        </div>
      </div>

      <!-- Active filter tags -->
      <% if (selectedCategory !== 'All' || selectedQualification !== 'All' || searchQuery) { %>
        <div style="display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; align-items: center;">
          <span style="font-size: 0.78rem; color: var(--color-text-muted); font-family: var(--font-mono);">ACTIVE FILTERS:</span>
          <% if (selectedCategory !== 'All') { %><span class="badge"><%= selectedCategory %></span><% } %>
          <% if (selectedQualification !== 'All') { %><span class="badge"><%= selectedQualification %> Pass</span><% } %>
          <% if (searchQuery) { %><span class="badge">"<%= searchQuery %>"</span><% } %>
          <a href="/exams" class="btn btn-ghost" style="padding: 2px 8px; font-size: 0.75rem; margin-left: 4px;">Clear All ×</a>
        </div>
      <% } %>
    </form>
  </div>
</section>

<!-- Exam Cards -->
<section class="section section-dark" style="padding-top: 48px; padding-bottom: 80px;">
  <div class="container">
    <% if (exams && exams.length > 0) { %>
      <p style="font-size: 0.82rem; color: var(--color-text-muted); font-family: var(--font-mono); margin-bottom: 24px; text-transform: uppercase; letter-spacing: 0.1em;">
        <%= exams.length %> exam<%= exams.length !== 1 ? 's' : '' %> found
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        <% exams.forEach(exam => { %>
          <div class="card" style="display: flex; flex-direction: column; padding: 28px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 14px;">
              <span class="badge"><%= exam.category %></span>
              <span class="badge badge-outline"><%= exam.minQualification %> Pass</span>
            </div>

            <p style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-accent); letter-spacing: 0.08em; margin-bottom: 8px;"><%= exam.code %></p>
            <h3 style="font-size: 1.1rem; margin-bottom: 10px; line-height: 1.3;"><%= exam.name %></h3>
            <p style="font-size: 0.875rem; line-height: 1.65; flex: 1; margin-bottom: 18px;"><%= exam.description.substring(0, 130) %>...</p>

            <% if (exam.examPosts && exam.examPosts.length > 0) { %>
              <p style="font-size: 0.78rem; color: var(--color-text-muted); margin-bottom: 16px;">
                <span style="color: var(--color-text-secondary); font-weight: 500;">Posts: </span>
                <%= exam.examPosts.slice(0,2).map(p => p.postName).join(', ') %><%= exam.examPosts.length > 2 ? ` +${exam.examPosts.length - 2} more` : '' %>
              </p>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 14px; margin-top: auto;">
              <span style="font-size: 0.75rem; color: var(--color-text-muted); font-family: var(--font-mono);"><%= exam.frequency %></span>
              <a href="/exams/<%= exam.code %>" class="btn btn-primary" style="padding: 7px 16px; font-size: 0.78rem;">View Guide &rarr;</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="card text-center" style="padding: 80px 32px; max-width: 500px; margin: 0 auto;">
        <div style="font-size: 2.5rem; margin-bottom: 16px;">🔍</div>
        <h3 style="margin-bottom: 10px;">No Exams Found</h3>
        <p style="margin-bottom: 28px;">No exams match your current filters. Try adjusting your search criteria.</p>
        <a href="/exams" class="btn btn-secondary">Reset All Filters</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
