<%- include('partials/header') %>

<!-- Hero Section with Parallax Depth -->
<section class="hero-parallax">
  <div class="hero-bg-layer"></div>
  <div class="container hero-content">
    <span class="kicker">EXAM PREPARATION GUIDE PLATFORM</span>
    <h1>Your Path to a Government Job, Simplified.</h1>
    <p>No noisy blogs, no ad clutter. Structured guidance for 10th pass, 12th pass, and graduate candidates preparing for SSC, UPSC, Railways, Banking, and Punjab State exams.</p>
    <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/exams" class="btn btn-primary">Explore Exam Directory &rarr;</a>
      <a href="/prep-levels" class="btn btn-secondary">View Preparation Levels</a>
    </div>
  </div>
</section>

<!-- Value Proposition Section -->
<section class="section section-secondary">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">WHY THE DREAMS</span>
      <h2>Built for Focus, Designed for Clarity</h2>
      <p>Finding the right exam shouldn't take days of reading unstructured blogs.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
      <div class="card">
        <div style="color: var(--color-accent); font-size: 1.8rem; margin-bottom: 16px;">🎯</div>
        <h3>Structured Exam Data</h3>
        <p>Clear qualifications, exam frequencies, major posts, and stage breakdowns for SSC, UPSC, Railways, Banking, and Punjab Police.</p>
      </div>

      <div class="card">
        <div style="color: var(--color-accent); font-size: 1.8rem; margin-bottom: 16px;">📚</div>
        <h3>Curated Books & Subjects</h3>
        <p>Hand-picked recommended books per subject so you know exactly which authors and study material to trust from Day 1.</p>
      </div>

      <div class="card">
        <div style="color: var(--color-accent); font-size: 1.8rem; margin-bottom: 16px;">✨</div>
        <h3>Guided by an Aspirant</h3>
        <p>Crafted by Sakshi Bansal — combining actual exam prep experience with clean, modern Node.js full-stack engineering.</p>
      </div>
    </div>
  </div>
</section>

<!-- Featured Exam Categories Grid -->
<section class="section section-dark">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">FEATURED CATEGORIES</span>
      <h2>Explore Popular Exam Pathways</h2>
      <p>Filter and find the exact exam matching your educational qualification.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      <% if (featuredExams && featuredExams.length > 0) { %>
        <% featuredExams.forEach(exam => { %>
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
              <span class="badge"><%= exam.category %></span>
              <span class="badge badge-outline"><%= exam.minQualification %> Pass</span>
            </div>
            <h3 style="margin-bottom: 12px; font-size: 1.25rem;"><%= exam.name %></h3>
            <p style="font-size: 0.9rem; margin-bottom: 20px; min-height: 54px; line-height: 1.5;"><%= exam.description.substring(0, 110) %>...</p>
            
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 16px; font-size: 0.85rem;">
              <span style="color: var(--color-text-secondary);"><%= exam.frequency %></span>
              <a href="/exams/<%= exam.code %>" class="btn btn-ghost" style="padding: 4px 8px;">View Syllabus &rarr;</a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div style="text-align: center; margin-top: 48px;">
      <a href="/exams" class="btn btn-secondary">View All Government Exams &rarr;</a>
    </div>
  </div>
</section>

<!-- Teaser Quote Section -->
<section class="section section-secondary">
  <div class="container" style="max-width: 900px; text-align: center;">
    <span class="kicker">FROM THE FOUNDER</span>
    <blockquote style="font-family: var(--font-display); font-size: 1.6rem; font-style: italic; color: var(--color-text-primary); margin: 24px 0 32px 0; line-height: 1.5;">
      "As a student preparing for government exams after 12th class, I experienced firsthand how chaotic information is online. I built The Dreams to give every aspirant a clean, distraction-free map to success."
    </blockquote>
    <p style="font-weight: 600; color: var(--color-accent); font-family: var(--font-mono);">— Sakshi Bansal, Creator & Developer</p>
    <div style="margin-top: 24px;">
      <a href="/about-me" class="btn btn-ghost">Read My Full Journey & Project Story &rarr;</a>
    </div>
  </div>
</section>

<!-- Contrasting Light CTA Section -->
<section class="section section-light">
  <div class="container" style="text-align: center; max-width: 750px;">
    <h2 style="color: var(--color-text-inverse); margin-bottom: 16px;">Have Doubts About Your Exam Eligibility?</h2>
    <p style="margin-bottom: 32px; color: #444444;">Send a direct message or query through our contact portal, or use our interactive chatbot assistant.</p>
    <a href="/contact" class="btn btn-primary" style="background-color: #0A0A0A; color: #F5F5F5;">Get Personalized Guidance &rarr;</a>
  </div>
</section>

<%- include('partials/footer') %>
