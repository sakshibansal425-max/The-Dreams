<%- include('partials/header') %>

<!-- Hero Section with Parallax Depth -->
<section class="hero-parallax">
  <div class="hero-bg-layer"></div>
  <div class="container hero-content">
    <span class="kicker">EXAM PREPARATION GUIDE PLATFORM</span>
    <h1>Your Path to a Government Job,<br>Simplified.</h1>
    <p>No noisy blogs, no ad clutter. Structured guidance for 10th pass, 12th pass, and graduate candidates preparing for SSC, UPSC, Railways, Banking, and Punjab State exams.</p>
    <div class="hero-cta">
      <a href="/exams" class="btn btn-primary">Explore Exam Directory &rarr;</a>
      <a href="/prep-levels" class="btn btn-secondary">View Preparation Levels</a>
    </div>
  </div>
</section>

<!-- Value Propositions -->
<section class="section section-secondary">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">WHY THE DREAMS</span>
      <h2>Built for Focus, Designed for Clarity</h2>
      <p>Finding the right government exam shouldn't take days of reading cluttered blogs.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      <div class="card" style="padding: 36px 32px;">
        <div style="width: 44px; height: 44px; background: var(--color-accent-subtle); border: 1px solid rgba(var(--color-accent-rgb), 0.2); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 1.25rem;">🎯</div>
        <h3 style="margin-bottom: 10px;">Structured Exam Data</h3>
        <p>Clear eligibility requirements, frequencies, major posts, and stage-by-stage selection processes for SSC, UPSC, Railways, Banking, and Punjab Police.</p>
      </div>

      <div class="card" style="padding: 36px 32px;">
        <div style="width: 44px; height: 44px; background: var(--color-accent-subtle); border: 1px solid rgba(var(--color-accent-rgb), 0.2); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 1.25rem;">📚</div>
        <h3 style="margin-bottom: 10px;">Curated Books & Subjects</h3>
        <p>Hand-picked recommended books per subject so you know exactly which authors and study materials to trust from Day 1 of preparation.</p>
      </div>

      <div class="card" style="padding: 36px 32px;">
        <div style="width: 44px; height: 44px; background: var(--color-accent-subtle); border: 1px solid rgba(var(--color-accent-rgb), 0.2); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 1.25rem;">✨</div>
        <h3 style="margin-bottom: 10px;">Guided by an Aspirant</h3>
        <p>Crafted by Sakshi Bansal — combining real exam prep experience with modern Node.js full-stack engineering skills.</p>
      </div>
    </div>
  </div>
</section>

<!-- Featured Exam Grid -->
<section class="section section-dark">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">FEATURED CATEGORIES</span>
      <h2>Explore Popular Exam Pathways</h2>
      <p>Filter and find the exact exam matching your educational qualification.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
      <% if (featuredExams && featuredExams.length > 0) { %>
        <% featuredExams.forEach(exam => { %>
          <div class="card" style="display: flex; flex-direction: column; padding: 28px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; gap: 8px;">
              <span class="badge"><%= exam.category %></span>
              <span class="badge badge-outline"><%= exam.minQualification %> Pass</span>
            </div>
            <h3 style="font-size: 1.15rem; margin-bottom: 10px; line-height: 1.3;"><%= exam.name %></h3>
            <p style="font-size: 0.875rem; line-height: 1.65; flex: 1; margin-bottom: 20px;"><%= exam.description.substring(0, 120) %>...</p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border); padding-top: 14px; margin-top: auto;">
              <span style="font-size: 0.78rem; color: var(--color-text-muted); font-family: var(--font-mono);"><%= exam.frequency %></span>
              <a href="/exams/<%= exam.code %>" class="btn btn-ghost" style="padding: 4px 10px; font-size: 0.8rem;">View Syllabus &rarr;</a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <div style="text-align: center; margin-top: 48px;">
      <a href="/exams" class="btn btn-secondary">View All Government Exams &rarr;</a>
    </div>
  </div>
</section>

<!-- Founder Quote Section with Image -->
<section class="section section-secondary">
  <div class="container" style="max-width: 960px;">
    <div class="card card--flat" style="padding: 48px; display: grid; grid-template-columns: 240px 1fr; gap: 48px; align-items: center;">
      <div>
        <img src="/images/the-motivation.png" alt="The Motivation - Sakshi Bansal"
          style="width: 100%; border-radius: var(--radius-md); border: 2px solid rgba(var(--color-accent-rgb), 0.3); aspect-ratio: 1; object-fit: cover;">
      </div>
      <div>
        <span class="kicker">FROM THE FOUNDER</span>
        <blockquote style="font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--color-text-primary); margin: 14px 0 20px 0; line-height: 1.55; border-left: 3px solid var(--color-accent); padding-left: 20px;">
          "As a student preparing for government exams after 12th class, I experienced firsthand how chaotic information is online. I built The Dreams to give every aspirant a clean, distraction-free map to success."
        </blockquote>
        <p style="font-weight: 600; color: var(--color-accent); font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 20px;">— Sakshi Bansal, Creator & Developer</p>
        <a href="/about-me" class="btn btn-secondary" style="font-size: 0.85rem;">Read My Full Journey &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- Light CTA Section -->
<section class="section section-light">
  <div class="container text-center" style="max-width: 680px;">
    <h2 style="color: var(--color-text-inverse); margin-bottom: 14px;">Have Doubts About Your Exam Eligibility?</h2>
    <p style="margin-bottom: 32px; color: #555;">Send a direct message or query through our contact portal, or use our interactive chatbot assistant to get instant guidance.</p>
    <a href="/contact" class="btn btn-primary" style="background-color: #0A0A0A; color: #F0F0F0; border-color: #0A0A0A;">Get Personalized Guidance &rarr;</a>
  </div>
</section>

<%- include('partials/footer') %>
