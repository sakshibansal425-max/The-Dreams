<%- include('../partials/header') %>

<section class="section section-dark" style="padding-top: 130px;">
  <div class="container" style="max-width: 900px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div>
        <span class="kicker">ADMINISTRATION</span>
        <h1>Feature Flags & System Toggles</h1>
      </div>

      <div>
        <a href="/admin/dashboard" class="btn btn-secondary" style="font-size: 0.85rem;">&larr; Dashboard</a>
      </div>
    </div>

    <div class="card" style="padding: 36px;">
      <p style="margin-bottom: 24px; color: var(--color-text-secondary);">
        Enable or disable feature modules across the live site dynamically without modifying source code or redeploying the server.
      </p>

      <% if (flags && flags.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <% flags.forEach(flag => { %>
            <div style="padding: 20px; background-color: var(--color-bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
              <div>
                <strong style="font-family: var(--font-mono); color: var(--color-accent); font-size: 0.95rem;"><%= flag.key %></strong>
                <p style="font-size: 0.85rem; color: var(--color-text-secondary); margin-top: 4px;"><%= flag.description %></p>
              </div>

              <div style="display: flex; align-items: center; gap: 16px;">
                <span class="badge <%= flag.enabled ? '' : 'badge-outline' %>">
                  <%= flag.enabled ? 'ACTIVE' : 'DISABLED' %>
                </span>

                <form action="/admin/feature-flags/<%= flag.id %>/toggle" method="POST">
                  <button type="submit" class="btn <%= flag.enabled ? 'btn-secondary' : 'btn-primary' %>" style="padding: 6px 14px; font-size: 0.8rem;">
                    <%= flag.enabled ? 'Disable Module' : 'Enable Module' %>
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p style="color: var(--color-text-secondary); text-align: center;">No feature flags configured.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
