<%- include('../partials/header') %>

<section class="section section-dark" style="padding-top: 130px;">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px;">
      <div>
        <span class="kicker">ADMINISTRATION</span>
        <h1>Contact Form Submissions</h1>
      </div>

      <div style="display: flex; gap: 12px;">
        <a href="/admin/dashboard" class="btn btn-secondary" style="font-size: 0.85rem;">&larr; Dashboard</a>
        <a href="/admin/submissions?status=all" class="btn <%= currentFilter === 'all' ? 'btn-primary' : 'btn-secondary' %>" style="font-size: 0.85rem;">All</a>
        <a href="/admin/submissions?status=unread" class="btn <%= currentFilter === 'unread' ? 'btn-primary' : 'btn-secondary' %>" style="font-size: 0.85rem;">Unread Only</a>
        <a href="/admin/submissions?status=archived" class="btn <%= currentFilter === 'archived' ? 'btn-primary' : 'btn-secondary' %>" style="font-size: 0.85rem;">Archived</a>
      </div>
    </div>

    <div class="card" style="padding: 32px;">
      <% if (submissions && submissions.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 24px;">
          <% submissions.forEach(sub => { %>
            <div style="padding: 24px; background-color: var(--color-bg-secondary); border-radius: var(--radius-sm); border-left: 4px solid <%= !sub.isRead ? 'var(--color-accent)' : 'var(--color-border)' %>;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <div>
                  <h3 style="font-size: 1.15rem; margin-bottom: 4px;"><%= sub.subject %></h3>
                  <span style="font-size: 0.85rem; color: var(--color-text-secondary);">From: <strong><%= sub.name %></strong> (<%= sub.email %>)</span>
                </div>
                
                <span style="font-size: 0.8rem; font-family: var(--font-mono); color: var(--color-text-secondary);">
                  <%= new Date(sub.submittedAt).toLocaleString() %>
                </span>
              </div>

              <div style="margin: 16px 0; padding: 16px; background: var(--color-surface); border-radius: var(--radius-sm); font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap;"><%= sub.message %></div>

              <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <form action="/admin/submissions/<%= sub.id %>/toggle-read" method="POST" style="display: inline;">
                  <button type="submit" class="btn btn-secondary" style="font-size: 0.75rem; padding: 6px 12px;">
                    <%= sub.isRead ? 'Mark as Unread' : 'Mark as Read' %>
                  </button>
                </form>

                <% if (!sub.isArchived) { %>
                  <form action="/admin/submissions/<%= sub.id %>/archive" method="POST" style="display: inline;">
                    <button type="submit" class="btn btn-ghost" style="font-size: 0.75rem; color: #ff6b6b; padding: 6px 12px;">
                      Archive Submission
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 48px 0; color: var(--color-text-secondary);">
          <p>No submissions found under the "<%= currentFilter %>" filter.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
