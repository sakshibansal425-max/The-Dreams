<%- include('partials/header') %>

<!-- Hero with Image Layout -->
<section class="section section-dark" style="padding-top: 140px; padding-bottom: 80px;">
  <div class="container" style="max-width: 980px;">
    <div style="display: grid; grid-template-columns: 220px 1fr; gap: 60px; align-items: center;">
      <!-- Profile Card -->
      <div style="text-align: center;">
        <div style="border-radius: var(--radius-md); border: 2px solid rgba(var(--color-accent-rgb), 0.4); overflow: hidden; margin-bottom: 16px; aspect-ratio: 1; background: var(--color-surface);">
          <img src="/images/believe-in-yourself.png" alt="Believe In Yourself — Sakshi Bansal" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <h3 style="font-size: 1rem; margin-bottom: 4px;">Sakshi Bansal</h3>
        <p style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-accent); letter-spacing: 0.06em; line-height: 1.5;">Full-Stack Dev<br>Exam Aspirant</p>
      </div>

      <!-- Bio Text -->
      <div>
        <span class="kicker">MY STORY</span>
        <h1 style="margin: 10px 0 18px; font-size: clamp(1.8rem, 3.5vw, 2.5rem);">Hi, I'm Sakshi Bansal.</h1>
        <p style="font-size: 1.05rem; line-height: 1.8; margin-bottom: 18px; color: var(--color-text-secondary);">
          I completed my 12th class from <strong style="color: var(--color-text-primary);">Punjab School Education Board (PSEB)</strong>. Like thousands of students, after passing senior secondary exams, I stepped directly into the world of Indian government competitive exam preparation.
        </p>
        <p style="font-size: 0.975rem; line-height: 1.75; color: var(--color-text-secondary);">
          While preparing for SSC CHSL, Punjab Police, and State Selection Boards, I noticed how fragmented and messy exam guidance was online. My passion for software engineering motivated me to build a solution myself — and <em>The Dreams</em> was born.
        </p>
      </div>
    </div>
  </div>
</section>

