<%- include('partials/header') %>

<section class="section section-dark" style="padding-top: 140px; padding-bottom: 80px;">
  <div class="container" style="max-width: 980px;">
    <!-- Page Header -->
    <div class="section-heading" style="text-align: left; margin-bottom: var(--space-8);">
      <span class="kicker">REACH OUT TO US</span>
      <h1 style="margin: 10px 0 14px;">Contact &amp; Student Guidance</h1>
      <p style="font-size: 1.05rem; max-width: 600px;">Have doubts about exam eligibility, book choices, or state police requirements? Send a message directly to Sakshi.</p>
    </div>

    <!-- Alert Banner: Success -->
    <% if (typeof submitted !== 'undefined' && submitted) { %>
      <div style="margin-bottom: 32px; padding: 20px 24px; background: rgba(74, 222, 128, 0.08); border: 1px solid rgba(74, 222, 128, 0.3); border-radius: var(--radius-md); display: flex; align-items: center; gap: 14px;">
        <span style="font-size: 1.2rem;">✅</span>
        <div>
          <strong style="color: #4ADE80; display: block; margin-bottom: 4px;">Message Sent Successfully!</strong>
          <p style="font-size: 0.875rem; margin: 0;">Thank you for reaching out. Sakshi will review your query and respond within 24–48 hours.</p>
        </div>
      </div>
    <% } %>

    <!-- Alert Banner: Error -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="margin-bottom: 32px; padding: 20px 24px; background: rgba(248, 113, 113, 0.08); border: 1px solid rgba(248, 113, 113, 0.3); border-radius: var(--radius-md); display: flex; align-items: center; gap: 14px;">
        <span style="font-size: 1.2rem;">⚠️</span>
        <div>
          <strong style="color: #F87171; display: block; margin-bottom: 4px;">Submission Error</strong>
          <p style="font-size: 0.875rem; margin: 0;"><%= error %></p>
        </div>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 3fr 2fr; gap: 32px; align-items: flex-start;">
      <!-- Contact Form -->
      <div class="card" style="padding: 40px;">
        <h2 style="font-size: 1.3rem; margin-bottom: 28px;">Send a Direct Query</h2>

        <form action="/contact" method="POST">
          <!-- Honeypot -->
          <div style="display: none;">
            <input type="text" id="honeypot" name="honeypot" autocomplete="off">
          </div>

          <div class="form-group">
            <label class="form-label" for="name">Your Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Rahul Sharma" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="e.g. rahul@example.com" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="subject">Subject / Exam Concern</label>
            <input type="text" id="subject" name="subject" class="form-control" placeholder="e.g. SSC CHSL Eligibility Query" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="message">Detailed Message</label>
            <textarea id="message" name="message" class="form-control" rows="5" placeholder="Write your question or feedback here..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary w-full" style="margin-top: 8px;">Submit Query &rarr;</button>
        </form>
      </div>

      <!-- Sidebar -->
      <div style="display: flex; flex-direction: column; gap: 20px; position: sticky; top: 90px;">
        <div class="card" style="padding: 28px;">
          <h3 style="font-size: 0.72rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border);">Direct Email</h3>
          <p style="font-size: 0.875rem; line-height: 1.65; margin-bottom: 14px;">Prefer email? Reach Sakshi directly for queries or developer networking:</p>
          <a href="mailto:sakshibansal425@gmail.com" style="font-family: var(--font-mono); color: var(--color-accent); font-size: 0.82rem; word-break: break-all;">sakshibansal425@gmail.com</a>
        </div>

        <div class="card" style="padding: 28px;">
          <h3 style="font-size: 0.72rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border);">Response Time</h3>
          <p style="font-size: 0.875rem; line-height: 1.65;">Submissions are stored in our Admin Portal and reviewed daily. Expect a response within <strong>24–48 hours</strong>.</p>
        </div>

        <div class="card" style="padding: 28px; background: var(--color-accent-subtle); border-color: rgba(var(--color-accent-rgb), 0.2);">
          <h3 style="font-size: 0.72rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin-bottom: 12px;">Instant Help</h3>
          <p style="font-size: 0.875rem; line-height: 1.65; margin-bottom: 16px;">Need a quick answer? Use our chatbot assistant — click the gold button in the bottom-right corner.</p>
          <div style="font-size: 0.78rem; color: var(--color-text-muted);">Available on all pages</div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
