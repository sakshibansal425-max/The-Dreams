<%- include('partials/header') %>

<!-- Breadcrumb + Header -->
<section class="section section-dark" style="padding-top: 140px; padding-bottom: 0;">
  <div class="container">
    <div style="margin-bottom: 24px;">
      <a href="/exams" class="btn btn-ghost" style="padding-left: 0; font-size: 0.85rem;">&larr; Back to Exam Directory</a>
    </div>

    <!-- Exam Header Card -->
    <div style="padding: 40px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); border-left: 5px solid var(--color-accent); margin-bottom: 0;">
      <div style="display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; align-items: center;">
        <span class="badge"><%= exam.category %></span>
        <span class="badge badge-outline"><%= exam.minQualification %> Pass</span>
        <span class="badge badge-outline" style="border-color: rgba(var(--color-accent-rgb),0.3); color: var(--color-accent);"><%= exam.frequency %></span>
      </div>

      <p style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-text-muted); letter-spacing: 0.12em; margin-bottom: 8px;">EXAM CODE: <%= exam.code %></p>
      <h1 style="font-size: clamp(1.6rem, 3.5vw, 2.25rem); margin-bottom: 16px; line-height: 1.25;"><%= exam.name %></h1>
      <p style="font-size: 1rem; line-height: 1.75; max-width: 850px;"><%= exam.description %></p>

      <% if (exam.officialLink) { %>
        <div style="margin-top: 24px;">
          <a href="<%= exam.officialLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="font-size: 0.82rem; padding: 8px 18px;">
            Official Portal &nearr;
          </a>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Main Content -->
<section class="section section-dark" style="padding-top: 40px;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 340px; gap: 32px; align-items: flex-start;">

      <!-- Left Column -->
      <div style="display: flex; flex-direction: column; gap: 28px;">

        <!-- Selection Pattern -->
        <div class="card" style="padding: 36px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--color-accent);">01</span> Selection Process
          </h2>
          <% if (exam.examPatterns && exam.examPatterns.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 0;">
              <% exam.examPatterns.forEach((stage, i) => { %>
                <div style="display: flex; gap: 16px; padding: 16px 0; <%= i < exam.examPatterns.length - 1 ? 'border-bottom: 1px solid var(--color-border);' : '' %>">
                  <div style="width: 32px; height: 32px; min-width: 32px; background: var(--color-accent-subtle); border: 1px solid rgba(var(--color-accent-rgb),0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-accent); font-weight: 600; margin-top: 2px;">
                    <%= stage.stageOrder %>
                  </div>
                  <div style="font-size: 0.9rem; line-height: 1.55; color: var(--color-text-primary); padding-top: 4px;"><%= stage.stageName %></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p style="font-size: 0.875rem;">Single-stage computer-based competitive examination.</p>
          <% } %>
        </div>

        <!-- Posts -->
        <% if (exam.examPosts && exam.examPosts.length > 0) { %>
        <div class="card" style="padding: 36px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--color-accent);">02</span> Recruiting Posts
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
            <% exam.examPosts.forEach(post => { %>
              <div style="padding: 14px 16px; background: var(--color-surface-2, #222); border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                <p style="font-size: 0.875rem; color: var(--color-text-primary); font-weight: 500; margin-bottom: 6px; line-height: 1.3;"><%= post.postName %></p>
                <span class="badge badge-outline" style="font-size: 0.65rem;"><%= post.postLevel %></span>
              </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Subjects & Books -->
        <div class="card" style="padding: 36px;">
          <h2 style="font-size: 1.3rem; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
            <span style="color: var(--color-accent);">03</span> Subjects & Recommended Books
          </h2>
          <% if (exam.examSubjects && exam.examSubjects.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 20px;">
              <% exam.examSubjects.forEach(es => { %>
                <div style="padding: 20px; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                  <h3 style="font-size: 1rem; margin-bottom: 6px; color: var(--color-text-primary);"><%= es.subject.name %></h3>
                  <% if (es.subject.description) { %>
                    <p style="font-size: 0.82rem; color: var(--color-text-secondary); margin-bottom: 14px; line-height: 1.55;"><%= es.subject.description %></p>
                  <% } %>

                  <% if (es.subject.subjectBooks && es.subject.subjectBooks.length > 0) { %>
                    <div style="border-top: 1px dashed var(--color-border); padding-top: 12px;">
                      <p style="font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">Recommended Books</p>
                      <div style="display: flex; flex-direction: column; gap: 8px;">
                        <% es.subject.subjectBooks.forEach(sb => { %>
                          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                            <span style="font-size: 0.84rem; color: var(--color-text-primary);">
                              <strong><%= sb.book.title %></strong>
                              <% if (sb.book.author) { %><span style="color: var(--color-text-secondary); font-weight: 400;"> — <%= sb.book.author %></span><% } %>
                            </span>
                            <% if (sb.book.link) { %>
                              <a href="<%= sb.book.link %>" target="_blank" rel="noopener" style="font-size: 0.72rem; color: var(--color-accent); white-space: nowrap; flex-shrink: 0;">Buy &nearr;</a>
                            <% } %>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p style="font-size: 0.875rem;">Subject details being updated.</p>
          <% } %>
        </div>
      </div>

      <!-- Right Sidebar -->
      <div style="position: sticky; top: 90px; display: flex; flex-direction: column; gap: 20px;">
        <!-- Quick Summary -->
        <div class="card" style="padding: 28px;">
          <h3 style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--color-text-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 20px; border-bottom: 1px solid var(--color-border); padding-bottom: 12px;">Quick Summary</h3>

          <div style="display: flex; flex-direction: column; gap: 16px; font-size: 0.875rem;">
            <div>
              <p style="font-size: 0.7rem; color: var(--color-text-muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px;">Qualification</p>
              <strong><%= exam.minQualification %> Pass</strong>
            </div>
            <div>
              <p style="font-size: 0.7rem; color: var(--color-text-muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px;">Category</p>
              <strong><%= exam.category %></strong>
            </div>
            <div>
              <p style="font-size: 0.7rem; color: var(--color-text-muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px;">Frequency</p>
              <strong><%= exam.frequency %></strong>
            </div>
            <% if (exam.examPrepLevels && exam.examPrepLevels.length > 0) { %>
            <div>
              <p style="font-size: 0.7rem; color: var(--color-text-muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px;">Prep Level</p>
              <span class="badge" style="font-size: 0.72rem;">Level <%= exam.examPrepLevels[0].prepLevel.levelNumber %> — <%= exam.examPrepLevels[0].prepLevel.levelName %></span>
            </div>
            <% } %>
          </div>

          <div style="border-top: 1px solid var(--color-border); padding-top: 20px; margin-top: 20px;">
            <a href="/contact" class="btn btn-primary w-full">Ask a Question &rarr;</a>
          </div>
        </div>

        <!-- Related CTA -->
        <div class="card" style="padding: 24px; background: var(--color-accent-subtle); border-color: rgba(var(--color-accent-rgb), 0.2);">
          <h4 style="color: var(--color-accent); font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px;">Need Guidance?</h4>
          <p style="font-size: 0.82rem; line-height: 1.55; margin-bottom: 16px;">Use our chatbot or contact Sakshi directly for personalized exam advice.</p>
          <a href="/contact" class="btn btn-secondary w-full" style="font-size: 0.82rem;">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
